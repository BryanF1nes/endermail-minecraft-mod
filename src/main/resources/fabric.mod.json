{
	"schemaVersion": 1,
	"id": "endermail",
	"version": "${version}",
	"name": "endermail",
	"description": "Endermail is an item mod that converts the standard functionality of an enderchest to be server wide instead of a individual user.",
	"authors": [
		"Bryan"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/endermail/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"bryan.endermail.Endermail"
		],
		"client": [
			"bryan.endermail.client.EndermailClient"
		]
	},
	"mixins": [
		"endermail.mixins.json",
		{
			"config": "endermail.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
